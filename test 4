/* ---- STAGE 5: emotional grid ---- */
function stageGrid3() {
  const p = getPhase();
  const title = p >= 2 ? 'Select images that feel familiar' : 'Select all images showing a road';
  setHeader('Image Verification', title);

  const items = ['🛣️','🌧️','🪑','🚪','📺','🌃','🫀','👁️','🛣️'];
  const correct = new Set([0,8]);

  clear(body => {
    const instr = document.createElement('div');
    instr.className = 'grid-instruction';

    if (p >= 2) {
      instr.innerHTML = 'Select all images that feel <em>familiar</em> to you.';
    } else {
      instr.textContent = 'Select all squares containing a road or path.';
    }
    body.appendChild(instr);

    const grid = document.createElement('div');
    grid.className = 'captcha-grid';
    const selected = new Set();

    items.forEach((emoji, i) => {
      const cell = document.createElement('div');
      cell.className = 'grid-cell';
      cell.textContent = emoji;
      cell.onclick = () => {
        if (selected.has(i)) { selected.delete(i); cell.classList.remove('selected'); }
        else { selected.add(i); cell.classList.add('selected'); }
        if (p >= 2 && selected.size >= 3) state.bond += 1;
      };
      grid.appendChild(cell);
    });

    body.appendChild(grid);

    const btn = document.createElement('button');
    btn.className = 'btn-verify';
    btn.textContent = p >= 2 ? 'Submit selection' : 'Verify';

    btn.onclick = () => {
      state.trust += 1;
      if (p >= 2) state.bond += 2;
      state.answered++;
      btn.textContent = '✓ Noted';
      btn.style.background = getPhase() >= 3 ? '#7f1d1d' : '#16a34a';
      btn.disabled = true;
      setTimeout(nextStage, 700);
    };

    body.appendChild(btn);
  });
}

