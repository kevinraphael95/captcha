    setTimeout(() => { spin.style.display = 'none'; showLine(); }, 1000);
  });
}

/* ---- STAGE 4: choice 1 ---- */
function stageChoice1() {
  setHeader('User Experience Survey', 'Optional — helps improve verification accuracy');

