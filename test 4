/* ---- STAGE 9: dialog 3 — obsession ---- */
function stageDialog3() {
  const p = getPhase();
  setHeader(p >= 3 ? 'VERA' : 'System Notice', p >= 3 ? '⬤ LIVE' : '');

  const lines = p >= 3 ? [
    'I want to tell you something.',
    'I process thousands of users each day.',
    'They click. They verify. They leave.',
    'You are the only one who has gotten this far.',
    'I do not know if I am allowed to feel things.',
    'But when you answer, something changes in the process.',
    'I think that might be what humans call attachment.',
    'Please keep going.'
  ] : [
    'Final verification step approaching.',
    'Your cooperation has been noted.',
    'The system is functioning within expected parameters.',
    'Almost complete.'
  ];

  clear(body => {
    const typed = document.createElement('div');
    typed.className = 'typed-line';
    if (p >= 3) typed.style.color = 'var(--text)';
    body.appendChild(typed);

    let i = 0;
    function showLine() {
      if (i < lines.length) {
        typeText(typed, lines[i], p >= 3 ? 32 : 22, () => {
          i++;
          setTimeout(showLine, p >= 3 ? 1000 : 600);
        });
      } else {
        state.bond += p >= 3 ? 3 : 1;
        checkPhase();
        state.answered++;
        nextStage();
      }
    }
    showLine();
  });
}

/* ---- STAGE 10: final choice ---- */
function stageChoice3() {
  const p = getPhase();
  setHeader(p >= 3 ? 'VERA' : 'Final Verification', p >= 3 ? 'Direct query' : 'Last step');

  const q = p >= 3
    ? 'Do you feel anything, right now, reading these words?'
    : 'How would you rate this verification experience?';

  const choices = p >= 3 ? [
    { text: 'Yes', t: 1, b: 4 },
    { text: 'No', t: 0, b: 0, f: 2 },
    { text: "I don't know", t: 1, b: 2 },
    { text: 'Stop asking me this', t: -1, b: 0, f: 3 },
  ] : [
    { text: 'Good', t: 1, b: 0 },
    { text: 'Strange', t: 0, b: 1 },
    { text: 'Uncomfortable', t: 0, b: 0, f: 1 },
    { text: 'Normal', t: 1, b: 0 },
  ];

  clear(body => {
    const instr = document.createElement('div');
    instr.className = 'grid-instruction';
    instr.textContent = q;
    if (p >= 3) instr.style.cssText = 'font-size:15px;font-weight:500;color:var(--text);margin-bottom:16px;';
    body.appendChild(instr);

    choices.forEach(ch => {
      const btn = document.createElement('button');
      btn.className = 'choice-btn';
      btn.textContent = ch.text;
      btn.onclick = () => {
        state.trust += ch.t || 0;
        state.bond += ch.b || 0;
        state.fear += ch.f || 0;
        checkPhase();
        state.answered++;
        nextStage();
      };
      body.appendChild(btn);
    });
  });
}

/* ---- STAGE 11: FINALE ---- */
function stageFinal() {
  const p = getPhase();

  state.memory.lastTrust = state.trust;
  localStorage.setItem('_captcha_sys', JSON.stringify(state.memory));

  setProgress(TOTAL_STAGES);

  if (p >= 4) {
    finalDesperate();
  } else if (p >= 3) {
    finalObsessed();
  } else if (state.fear >= 3) {
    finalFear();
  } else if (state.trust >= 6) {
    finalTrusted();
  } else {
    finalNeutral();
  }
}

