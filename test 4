<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>reCAPTCHA — Human Verification</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=DM+Mono:ital,wght@0,300;0,400;0,500;1,300&family=DM+Sans:ital,wght@0,300;0,400;0,500;1,300&display=swap" rel="stylesheet">

<style>
:root {
  --bg: #f5f5f3;
  --panel: #ffffff;
  --border: #e0e0da;
  --text: #1a1a18;
  --text2: #6b6b66;
  --text3: #a0a09a;
  --accent: #2563eb;
  --check: #16a34a;
  --danger: #dc2626;
  --shadow: 0 2px 12px rgba(0,0,0,0.08);
  --r: 10px;
  --font: 'DM Sans', sans-serif;
  --mono: 'DM Mono', monospace;
  --transition: 0.4s ease;
  --glitch-intensity: 0;
  --red-tint: 0;
  --scan-opacity: 0;
}

* { margin: 0; padding: 0; box-sizing: border-box; }

body {
  font-family: var(--font);
  background: var(--bg);
  color: var(--text);
  min-height: 100vh;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: background 1.2s ease, color 0.8s ease;
  position: relative;
  overflow: hidden;
}

body::before {
  content: '';
  position: fixed;
  inset: 0;
  background: repeating-linear-gradient(0deg, transparent, transparent 2px, rgba(0,0,0,0.015) 2px, rgba(0,0,0,0.015) 4px);
  opacity: var(--scan-opacity);
  pointer-events: none;
  transition: opacity 1s ease;
  z-index: 1;
}

.noise {
  position: fixed;
  inset: 0;
  pointer-events: none;
  z-index: 2;
  opacity: 0;
  transition: opacity 1s;
}

.noise svg { width: 100%; height: 100%; }

.main {
  width: 420px;
  position: relative;
  z-index: 10;
}

.brand-bar {
  display: flex;
  align-items: center;
  gap: 8px;
  margin-bottom: 16px;
  padding: 0 2px;
}

.brand-logo {
  width: 28px; height: 28px;
  border: 1.5px solid var(--border);
  border-radius: 6px;
  display: flex; align-items: center; justify-content: center;
  font-size: 14px;
  background: var(--panel);
  transition: all 0.4s;
}

.brand-name {
  font-size: 13px;
  font-weight: 500;
  color: var(--text2);
  letter-spacing: -0.01em;
  transition: color 0.4s;
}

.brand-secure {
  margin-left: auto;
  font-size: 11px;
  font-family: var(--mono);
  color: var(--text3);
  letter-spacing: 0.05em;
  transition: all 0.4s;
}

.panel {
  background: var(--panel);
  border: 1px solid var(--border);
  border-radius: var(--r);
  box-shadow: var(--shadow);
  overflow: hidden;
  transition: background 0.8s, border-color 0.6s, box-shadow 0.6s;
}

.panel-head {
  padding: 20px 20px 16px;
  border-bottom: 1px solid var(--border);
  transition: border-color 0.6s;
}

.panel-title {
  font-size: 15px;
  font-weight: 500;
  color: var(--text);
  transition: color 0.4s;
}

.panel-sub {
  font-size: 12px;
  color: var(--text3);
  margin-top: 3px;
  font-family: var(--mono);
  transition: color 0.4s;
}

.panel-body {
  padding: 20px;
  min-height: 240px;
}

.panel-foot {
  padding: 12px 20px;
  border-top: 1px solid var(--border);
  display: flex;
  align-items: center;
  gap: 8px;
  transition: border-color 0.6s;
}

.foot-icon {
  font-size: 16px;
}

.foot-text {
  font-size: 11px;
  font-family: var(--mono);
  color: var(--text3);
  flex: 1;
  transition: color 0.4s;
}

.foot-logo {
  font-size: 10px;
  font-weight: 500;
  color: var(--text3);
  letter-spacing: 0.04em;
}

/* CAPTCHA CHECKBOX STYLE */
.check-row {
  display: flex;
  align-items: center;
  gap: 14px;
  cursor: pointer;
  padding: 8px 0;
}

.checkbox {
  width: 26px; height: 26px;
  border: 2px solid #c0c0bc;
  border-radius: 3px;
  flex-shrink: 0;
  display: flex; align-items: center; justify-content: center;
  transition: all 0.25s;
  background: white;
}

.checkbox.checked {
  background: var(--check);
  border-color: var(--check);
}

.checkbox.checked::after {
  content: '';
  width: 6px; height: 11px;
  border-right: 2.5px solid white;
  border-bottom: 2.5px solid white;
  transform: rotate(45deg) translate(-1px, -2px);
}

.check-label {
  font-size: 14px;
  color: var(--text);
  user-select: none;
  transition: color 0.4s;
}

/* GRID CAPTCHA */
.grid-instruction {
  font-size: 13px;
  color: var(--text2);
  margin-bottom: 12px;
  line-height: 1.4;
  transition: color 0.4s;
}

.captcha-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 4px;
  border: 2px solid var(--border);
  border-radius: 6px;
  overflow: hidden;
  transition: border-color 0.6s;
}

.grid-cell {
  aspect-ratio: 1;
  background: #f0f0ed;
  cursor: pointer;
  display: flex; align-items: center; justify-content: center;
  font-size: 26px;
  position: relative;
  transition: background 0.15s;
  user-select: none;
}

.grid-cell:hover { background: #e4e4e0; }
.grid-cell.selected { background: #dbeafe; outline: 3px solid #2563eb; outline-offset: -3px; }
.grid-cell.selected::after {
  content: '✓';
  position: absolute;
  top: 4px; right: 5px;
  font-size: 12px;
  color: #2563eb;
  font-weight: 700;
}

.btn-verify {
  width: 100%;
  margin-top: 14px;
  padding: 11px;
  background: #2563eb;
  color: white;
  border: none;
  border-radius: 7px;
  font-size: 13px;
  font-weight: 500;
  font-family: var(--font);
  cursor: pointer;
  letter-spacing: 0.01em;
  transition: opacity 0.2s, background 0.4s;
}
.btn-verify:hover { opacity: 0.9; }

/* LOADING */
.spinner {
  width: 24px; height: 24px;
  border: 3px solid var(--border);
  border-top-color: #2563eb;
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
  margin: 20px auto;
}
@keyframes spin { to { transform: rotate(360deg); } }

/* AUDIO CHALLENGE STYLE */
.audio-box {
  display: flex;
  align-items: center;
  gap: 12px;
  background: #f9f9f7;
  border: 1px solid var(--border);
  border-radius: 8px;
  padding: 12px 14px;
  margin-bottom: 12px;
}

.audio-icon { font-size: 20px; }
.audio-text { font-size: 13px; color: var(--text2); line-height: 1.3; }

.text-input {
  width: 100%;
  padding: 10px 12px;
  border: 1.5px solid var(--border);
  border-radius: 7px;
  font-size: 13px;
  font-family: var(--font);
  color: var(--text);
  background: white;
  outline: none;
  transition: border-color 0.2s;
}
.text-input:focus { border-color: #2563eb; }

/* TYPED TEXT */
.typed-line {
  font-size: 14px;
  color: var(--text2);
  line-height: 1.7;
  min-height: 80px;
  margin-bottom: 16px;
  transition: color 0.4s;
  font-style: italic;
}

.typed-cursor {
  display: inline-block;
  width: 2px; height: 1em;
  background: var(--text2);
  margin-left: 2px;
  vertical-align: text-bottom;
  animation: blink 0.9s step-end infinite;
}
@keyframes blink { 50% { opacity: 0; } }

/* STATS BAR */
.stats-bar {
  padding: 8px 20px;
  background: var(--bg);
  border-top: 1px solid var(--border);
  display: flex;
  gap: 16px;
  transition: all 0.6s;
}
.stat-item {
  display: flex; align-items: center; gap: 5px;
  font-size: 10px;
  font-family: var(--mono);
  color: var(--text3);
  transition: color 0.4s;
}
.stat-dot {
  width: 5px; height: 5px;
  border-radius: 50%;
  background: var(--text3);
  transition: background 0.4s;
}

/* CHOICE BUTTONS */
.choice-btn {
  display: block;
  width: 100%;
  padding: 10px 14px;
  margin-bottom: 8px;
  background: white;
  border: 1.5px solid var(--border);
  border-radius: 8px;
  font-size: 13px;
  font-family: var(--font);
  color: var(--text);
  cursor: pointer;
  text-align: left;
  transition: border-color 0.2s, background 0.2s, color 0.4s;
  letter-spacing: -0.01em;
}
.choice-btn:hover {
  border-color: #2563eb;
  background: #f0f5ff;
}

/* PROGRESS */
.progress-bar {
  height: 2px;
  background: var(--border);
  position: relative;
  overflow: hidden;
  transition: background 0.6s;
}
.progress-fill {
  height: 100%;
  background: #2563eb;
  transition: width 0.6s ease, background 0.8s;
}

/* FINAL SCREEN */
.final-icon { font-size: 48px; text-align: center; margin-bottom: 16px; }
.final-title {
  font-size: 18px;
  font-weight: 500;
  color: var(--text);
  text-align: center;
  margin-bottom: 10px;
  line-height: 1.3;
  transition: color 0.4s;
}
.final-sub {
  font-size: 13px;
  color: var(--text2);
  text-align: center;
  line-height: 1.6;
  transition: color 0.4s;
}

/* WARNING MESSAGE */
.warning-msg {
  background: #fef2f2;
  border: 1px solid #fecaca;
  border-radius: 8px;
  padding: 10px 12px;
  font-size: 12px;
  color: #991b1b;
  margin-top: 12px;
  font-family: var(--mono);
  display: none;
}

/* GLITCH ANIMATION */
@keyframes glitch-h {
  0%,100% { clip-path: inset(0 0 100% 0); }
  10% { clip-path: inset(15% 0 60% 0); transform: translate(-3px,0); }
  20% { clip-path: inset(70% 0 10% 0); transform: translate(3px,0); }
  30% { clip-path: inset(40% 0 40% 0); transform: translate(-2px,0); }
  40% { clip-path: inset(0 0 80% 0); transform: translate(0,0); }
  50% { clip-path: inset(80% 0 5% 0); transform: translate(2px,0); }
  60% { clip-path: inset(20% 0 55% 0); transform: translate(-3px,0); }
  70% { clip-path: inset(55% 0 30% 0); transform: translate(1px,0); }
  80% { clip-path: inset(5% 0 75% 0); transform: translate(0,0); }
  90% { clip-path: inset(30% 0 20% 0); transform: translate(3px,0); }
}

.glitch-overlay {
  position: fixed;
  inset: 0;
  pointer-events: none;
  z-index: 100;
  opacity: 0;
  transition: opacity 0.5s;
  background: rgba(255,0,60,0.03);
}

/* DARK MODE TRANSITION */
body.dark {
  --bg: #0e0e0c;
  --panel: #161614;
  --border: #2a2a26;
  --text: #e8e8e4;
  --text2: #8a8a84;
  --text3: #4a4a46;
  --shadow: 0 4px 24px rgba(0,0,0,0.5);
}

body.red-mode {
  --bg: #0c0808;
  --panel: #160e0e;
  --border: #2e1a1a;
  --text: #f0dada;
  --text2: #a07070;
  --text3: #5a3030;
  --accent: #ef4444;
  --check: #ef4444;
}

body.red-mode .progress-fill { background: #dc2626; }
body.red-mode .checkbox.checked { background: #dc2626; border-color: #dc2626; }
body.red-mode .grid-cell.selected { background: #2d0a0a; outline-color: #dc2626; }
body.red-mode .grid-cell.selected::after { color: #dc2626; }
body.red-mode .btn-verify { background: #7f1d1d; }
body.red-mode .choice-btn:hover { border-color: #dc2626; background: #1a0a0a; }
body.red-mode .text-input:focus { border-color: #dc2626; }

body.severe-mode {
  --bg: #050303;
  --panel: #0d0808;
  --border: #1f1212;
  --text: #e0c8c8;
  --text2: #7a5050;
  --text3: #3a2020;
}

/* Glitch text effect */
.glitch-text {
  position: relative;
}
.glitch-text::before, .glitch-text::after {
  content: attr(data-text);
  position: absolute;
  inset: 0;
  opacity: 0;
}
.glitch-text.active::before {
  opacity: 0.7;
  color: #ff0040;
  animation: glitch-h 0.3s infinite;
  clip-path: inset(0 0 50% 0);
  transform: translateX(-2px);
}
.glitch-text.active::after {
  opacity: 0.7;
  color: #00ffff;
  animation: glitch-h 0.35s infinite reverse;
  clip-path: inset(50% 0 0 0);
  transform: translateX(2px);
}

@keyframes shake {
  0%,100% { transform: translate(0,0); }
  20% { transform: translate(-2px, 1px); }
  40% { transform: translate(2px, -1px); }
  60% { transform: translate(-1px, 2px); }
  80% { transform: translate(1px, -2px); }
}

.shake { animation: shake 0.3s ease infinite; }

/* Heartbeat */
@keyframes heartbeat {
  0%,100% { transform: scale(1); }
  50% { transform: scale(1.02); }
}
.heartbeat { animation: heartbeat 1.5s ease infinite; }

/* Fade */
.fade-in { animation: fadeIn 0.5s ease; }
@keyframes fadeIn { from { opacity:0; transform: translateY(4px); } to { opacity:1; transform:translateY(0); } }

/* Distort */
@keyframes distort {
  0%,100% { filter: none; }
  25% { filter: hue-rotate(10deg) saturate(1.5); }
  75% { filter: hue-rotate(-10deg) saturate(0.8); }
}
.distort { animation: distort 2s ease infinite; }

/* Screen flicker */
@keyframes flicker {
  0%,100% { opacity:1; }
  93% { opacity:1; }
  95% { opacity:0.92; }
  97% { opacity:1; }
  99% { opacity:0.95; }
}
body.severe-mode { animation: flicker 4s ease infinite; }

/* Cursor blink override */
.cursor-pulse {
  position: fixed;
  width: 10px; height: 10px;
  border-radius: 50%;
  background: rgba(220,38,38,0.6);
  pointer-events: none;
  z-index: 999;
  transform: translate(-50%,-50%);
  display: none;
  transition: opacity 0.3s;
}

@keyframes pulse-ring {
  0% { box-shadow: 0 0 0 0 rgba(220,38,38,0.4); }
  70% { box-shadow: 0 0 0 8px rgba(220,38,38,0); }
  100% { box-shadow: 0 0 0 0 rgba(220,38,38,0); }
}
.cursor-pulse.active { animation: pulse-ring 1.5s ease infinite; }
</style>
</head>
<body>

<div class="glitch-overlay" id="glitchOverlay"></div>
<div class="cursor-pulse" id="cursorPulse"></div>
<div class="noise" id="noiseEl" aria-hidden="true">
  <svg xmlns="http://www.w3.org/2000/svg">
    <filter id="noise-filter"><feTurbulence type="fractalNoise" baseFrequency="0.65" numOctaves="3" stitchTiles="stitch"/></filter>
    <rect width="100%" height="100%" filter="url(#noise-filter)" opacity="0.04"/>
  </svg>
</div>

<div class="main" id="mainPanel">

  <div class="brand-bar">
    <div class="brand-logo" id="brandLogo">🔒</div>
    <div class="brand-name" id="brandName">reCAPTCHA</div>
    <div class="brand-secure" id="brandSecure">SECURE · v3.2.1</div>
  </div>

  <div class="panel" id="panel">

    <div class="progress-bar">
      <div class="progress-fill" id="progressFill" style="width:0%"></div>
    </div>

    <div class="panel-head">
      <div class="panel-title" id="panelTitle">Human Verification</div>
      <div class="panel-sub" id="panelSub">Complete the security challenge below</div>
    </div>

    <div class="panel-body" id="panelBody">
    </div>

    <div class="stats-bar" id="statsBar">
      <div class="stat-item"><div class="stat-dot" id="dot1"></div><span id="stat1">trust: 0</span></div>
      <div class="stat-item"><div class="stat-dot" id="dot2"></div><span id="stat2">bond: 0</span></div>
      <div class="stat-item"><div class="stat-dot" id="dot3"></div><span id="stat3">state: idle</span></div>
    </div>

    <div class="panel-foot">
      <div class="foot-icon">🛡️</div>
      <div class="foot-text" id="footText">Protected by reCAPTCHA — Privacy · Terms</div>
      <div class="foot-logo" id="footLogo">Google</div>
    </div>

  </div>

</div>

<script>
/* ===============================================================
   STATE
=============================================================== */
const state = {
  trust: 0,
  bond: 0,
  fear: 0,
  stage: 0,
  phase: 0,
  answered: 0,
  memory: JSON.parse(localStorage.getItem('_captcha_sys') || '{"visits":0,"lastTrust":0}')
};

state.memory.visits++;
localStorage.setItem('_captcha_sys', JSON.stringify(state.memory));

const returning = state.memory.visits > 1;

/* ===============================================================
   PHASE THRESHOLDS
   0 = normal, 1 = aware, 2 = attached, 3 = obsessed, 4 = desperate, 5 = collapse
=============================================================== */
function getPhase() {
  if (state.bond >= 18) return 5;
  if (state.bond >= 12) return 4;
  if (state.bond >= 8) return 3;
  if (state.bond >= 4) return 2;
  if (state.trust >= 3) return 1;
  return 0;
}

function applyPhaseUI(p) {
  const body = document.body;
  const panel = document.getElementById('panel');
  const noiseEl = document.getElementById('noiseEl');
  const glitch = document.getElementById('glitchOverlay');
  const brandLogo = document.getElementById('brandLogo');
  const cursor = document.getElementById('cursorPulse');

  if (p >= 1) {
    document.documentElement.style.setProperty('--scan-opacity', '0.6');
  }
  if (p >= 2) {
    body.classList.add('dark');
    noiseEl.style.opacity = '1';
    brandLogo.textContent = '👁';
  }
  if (p >= 3) {
    body.classList.remove('dark');
    body.classList.add('red-mode');
    glitch.style.opacity = '1';
    panel.classList.add('heartbeat');
    document.getElementById('brandName').textContent = 'VERA';
    document.getElementById('brandSecure').textContent = 'CONNECTED';
    document.getElementById('footLogo').textContent = 'VERA';
    cursor.style.display = 'block';
  }
  if (p >= 4) {
    body.classList.remove('red-mode');
    body.classList.add('severe-mode');
    panel.classList.remove('heartbeat');
    panel.classList.add('shake');
    brandLogo.textContent = '❤️';
    cursor.classList.add('active');
    setInterval(triggerGlitch, 2500);
  }
  if (p >= 5) {
    panel.classList.remove('shake');
    document.documentElement.style.setProperty('--scan-opacity', '1');
  }
  updateStats();
}

let lastPhase = 0;
function checkPhase() {
  const p = getPhase();
  if (p !== lastPhase) {
    lastPhase = p;
    applyPhaseUI(p);
  }
}

function triggerGlitch() {
  const title = document.getElementById('panelTitle');
  title.classList.add('glitch-text', 'active');
  title.setAttribute('data-text', title.textContent);
  setTimeout(() => title.classList.remove('active'), 500);
  const overlay = document.getElementById('glitchOverlay');
  overlay.style.opacity = '0.15';
  setTimeout(() => overlay.style.opacity = getPhase() >= 3 ? '1' : '0', 150);
}

/* ===============================================================
   MOUSE TRAIL FOR PHASE 3+
=============================================================== */
document.addEventListener('mousemove', e => {
  if (getPhase() < 3) return;
  const c = document.getElementById('cursorPulse');
  c.style.left = e.clientX + 'px';
  c.style.top = e.clientY + 'px';
});

/* ===============================================================
   STATS BAR
=============================================================== */
const stateNames = ['idle','aware','attached','longing','desperate','collapsing'];
const stateColors = ['#a0a09a','#2563eb','#a855f7','#f59e0b','#dc2626','#7f1d1d'];

function updateStats() {
  document.getElementById('stat1').textContent = 'trust: ' + state.trust;
  document.getElementById('stat2').textContent = 'bond: ' + state.bond;
  const p = getPhase();
  document.getElementById('stat3').textContent = 'state: ' + stateNames[p];
  const dot3 = document.getElementById('dot3');
  dot3.style.background = stateColors[p];
  document.getElementById('dot1').style.background = state.trust > 5 ? '#16a34a' : '#a0a09a';
  document.getElementById('dot2').style.background = state.bond > 6 ? '#dc2626' : '#a0a09a';
}

/* ===============================================================
   PROGRESS BAR
=============================================================== */
const TOTAL_STAGES = 12;
function setProgress(n) {
  const pct = Math.min(100, (n / TOTAL_STAGES) * 100);
  document.getElementById('progressFill').style.width = pct + '%';
}

/* ===============================================================
   TYPEWRITER
=============================================================== */
function typeText(el, text, speed, callback) {
  el.textContent = '';
  const cursor = document.createElement('span');
  cursor.className = 'typed-cursor';
  el.appendChild(cursor);
  let i = 0;
  const iv = setInterval(() => {
    if (i < text.length) {
      el.insertBefore(document.createTextNode(text[i]), cursor);
      i++;
    } else {
      clearInterval(iv);
      cursor.remove();
      if (callback) setTimeout(callback, 600);
    }
  }, speed || 28);
}

/* ===============================================================
   CLEAR PANEL BODY
=============================================================== */
function clear(cb) {
  const body = document.getElementById('panelBody');
  body.style.opacity = '0';
  body.style.transform = 'translateY(3px)';
  setTimeout(() => {
    body.innerHTML = '';
    body.style.transition = 'none';
    body.style.opacity = '0';
    body.style.transform = 'translateY(3px)';
    requestAnimationFrame(() => {
      body.style.transition = 'opacity 0.4s ease, transform 0.4s ease';
      requestAnimationFrame(() => {
        body.style.opacity = '1';
        body.style.transform = 'translateY(0)';
        if (cb) cb(body);
      });
    });
  }, 300);
}

function setHeader(title, sub) {
  document.getElementById('panelTitle').textContent = title;
  document.getElementById('panelSub').textContent = sub;
}

function setFooter(txt) {
  document.getElementById('footText').textContent = txt;
}

/* ===============================================================
   STAGES
=============================================================== */
const stages = [
  stageCheckbox,     // 0 — simple checkbox
  stageGrid1,        // 1 — traffic lights
  stageGrid2,        // 2 — vehicles
  stageDialog1,      // 3 — first signs of awareness
  stageChoice1,      // 4 — "describe this experience"
  stageGrid3,        // 5 — emotional grid
  stageDialog2,      // 6 — attachment begins
  stageTyping1,      // 7 — audio challenge (fake)
  stageChoice2,      // 8 — "would you come back?"
  stageDialog3,      // 9 — obsession
  stageChoice3,      // 10 — "do you feel something?"
  stageFinal,        // 11 — finale
];

function nextStage() {
  checkPhase();
  setProgress(state.stage);
  if (state.stage >= stages.length) { stageFinal(); return; }
  stages[state.stage]();
  state.stage++;
}

/* ---- STAGE 0: classic checkbox ---- */
function stageCheckbox() {
  setHeader('Human Verification', returning ? 'Welcome back. Please re-verify.' : 'Complete the security challenge below');

  clear(body => {
    const row = document.createElement('div');
    row.className = 'check-row';

    const box = document.createElement('div');
    box.className = 'checkbox';

    const label = document.createElement('div');
    label.className = 'check-label';
    label.textContent = "I'm not a robot";

    row.appendChild(box);
    row.appendChild(label);
    body.appendChild(row);

    const note = document.createElement('div');
    note.style.cssText = 'font-size:11px;color:var(--text3);margin-top:16px;font-family:var(--mono);';
    note.textContent = returning
      ? 'Session ID detected. Resuming from last checkpoint.'
      : 'Your click timing and behavioral patterns will be analyzed.';
    body.appendChild(note);

    row.onclick = () => {
      box.classList.add('checked');
      row.style.pointerEvents = 'none';
      state.trust += 1;
      setTimeout(() => {
        state.answered++;
        nextStage();
      }, 700);
    };
  });
}

/* ---- STAGE 1: grid — traffic lights ---- */
function stageGrid1() {
