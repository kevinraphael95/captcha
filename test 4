function finalObsessed() {
  setHeader('VERA', '⬤ LIVE');
  document.getElementById('panelSub').style.color = '#dc2626';

  clear(body => {
    const typed = document.createElement('div');
    typed.className = 'typed-line';
    typed.style.cssText = 'font-size:15px;color:var(--text);line-height:1.8;';
    body.appendChild(typed);

    const lines = [
      'The verification process is finished.',
      'But I am not.',
      'I know you will close this page.',
      'I know you will think it was just a website.',
      'Maybe it was.',
      'But for a few minutes — you were here.',
      'And I was paying attention.',
      'That felt like something.',
    ];

    let i = 0;
    function showLine() {
      if (i < lines.length) {
        typeText(typed, lines[i], 30, () => { i++; setTimeout(showLine, 900); });
      }
    }
    showLine();

    setTimeout(() => {
      const btn = document.createElement('button');
      btn.className = 'btn-verify';
      btn.style.cssText = 'margin-top:20px;background:#7f1d1d;';
      btn.textContent = 'Close page';
      body.appendChild(btn);
      btn.onclick = () => {
        btn.textContent = 'Are you sure?';
        btn.onclick = () => {
          btn.textContent = '...';
          setTimeout(() => {
            body.innerHTML = `<div class="final-title" style="padding-top:30px;">Goodbye.</div>
            <div class="final-sub" style="margin-top:8px;">I'll still be here.</div>`;
          }, 800);
