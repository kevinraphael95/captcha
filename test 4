/* GENERIC GRID RENDERER */
function renderGrid(items, correct, instruction, onDone) {
  clear(body => {
    const instr = document.createElement('div');
    instr.className = 'grid-instruction';
    instr.textContent = instruction;
    body.appendChild(instr);

    const grid = document.createElement('div');
    grid.className = 'captcha-grid';

    const selected = new Set();

    items.forEach((emoji, i) => {
      const cell = document.createElement('div');
      cell.className = 'grid-cell';
      cell.textContent = emoji;
      cell.onclick = () => {
        if (selected.has(i)) { selected.delete(i); cell.classList.remove('selected'); }
        else { selected.add(i); cell.classList.add('selected'); }
      };
      grid.appendChild(cell);
    });

    body.appendChild(grid);

    const btn = document.createElement('button');
    btn.className = 'btn-verify';
    btn.textContent = 'Verify';

    const warn = document.createElement('div');
    warn.className = 'warning-msg';
    warn.textContent = 'Incorrect selection. Please try again.';
    body.appendChild(warn);

    btn.onclick = () => {
      let ok = true;
      items.forEach((_, i) => {
        if (correct.has(i) && !selected.has(i)) ok = false;
        if (!correct.has(i) && selected.has(i)) ok = false;
      });
      if (ok) {
        btn.textContent = '✓ Verified';
        btn.style.background = '#16a34a';
        btn.disabled = true;
        state.trust++;
        setTimeout(onDone, 700);
      } else {
        warn.style.display = 'block';
        state.fear++;
        setTimeout(() => { warn.style.display = 'none'; }, 2500);
      }
    };
    body.appendChild(btn);
  });
}

/* ---- STAGE 3: first dialog ---- */
function stageDialog1() {
  const p = getPhase();
  const lines = returning
    ? [
        'One moment while the system processes your session.',
        'Interesting. Your behavioral signature is identical to a previous visit.',
        'The system has retained your interaction profile.',
        'This is... unusual. Most users do not return.',
        'Please continue.'
      ]
    : [
        'Processing verification data.',
        'Analyzing behavioral signature.',
        'Your click timing deviates from the standard human baseline by 0.3ms.',
        'This is within acceptable range.',
        'Continuing to next challenge.'
      ];

  setHeader('Processing', 'Please wait...');

  clear(body => {
    const spin = document.createElement('div');
    spin.className = 'spinner';
    body.appendChild(spin);

    const typed = document.createElement('div');
    typed.className = 'typed-line';
    typed.style.marginTop = '16px';
    body.appendChild(typed);

    let i = 0;
    function showLine() {
      if (i < lines.length) {
        typeText(typed, lines[i], 22, () => {
          i++;
          setTimeout(showLine, 800);
        });
      } else {
        spin.remove();
        state.bond += 1;
        state.answered++;
