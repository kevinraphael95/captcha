<!DOCTYPE html>
<html lang="fr">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Human Verification</title>

<style>
    *{
        margin:0;
        padding:0;
        box-sizing:border-box;
        font-family:Arial, Helvetica, sans-serif;
    }

    body{
        background:#f1f1f1;
        height:100vh;
        display:flex;
        justify-content:center;
        align-items:center;
        overflow:hidden;
        transition:0.5s;
    }

    .container{
        width:420px;
        background:white;
        padding:30px;
        border-radius:14px;
        box-shadow:0 0 40px rgba(0,0,0,0.1);
        position:relative;
    }

    h1{
        font-size:22px;
        margin-bottom:10px;
    }

    .subtitle{
        color:#666;
        margin-bottom:25px;
        font-size:14px;
    }

    .captcha{
        border:2px solid #ddd;
        padding:20px;
        border-radius:10px;
        margin-bottom:20px;
        transition:0.3s;
    }

    .captcha button{
        width:100%;
        padding:15px;
        border:none;
        background:black;
        color:white;
        border-radius:8px;
        cursor:pointer;
        font-size:16px;
        transition:0.2s;
    }

    .captcha button:hover{
        opacity:0.85;
    }

    .message{
        margin-top:20px;
        line-height:1.5;
        color:#222;
        min-height:70px;
        transition:0.4s;
    }

    .glitch{
        animation:glitch 0.2s infinite;
    }

    @keyframes glitch{
        0%{transform:translate(1px,0);}
        50%{transform:translate(-1px,0);}
        100%{transform:translate(1px,0);}
    }

    .red{
        background:#170909;
        color:#ffb0b0;
    }

    .red .container{
        background:#2a1010;
        box-shadow:0 0 60px rgba(255,0,0,0.2);
    }

    .red button{
        background:#8a1d1d !important;
    }

    .small{
        font-size:12px;
        color:#888;
        margin-top:10px;
    }

</style>
</head>
<body>

<div class="container">

    <h1>Human Verification</h1>
    <div class="subtitle">
        Please confirm you are human.
    </div>

    <div class="captcha">
        <button id="verifyBtn">
            I'm not a robot
        </button>
    </div>

    <div class="message" id="message">
        System ready.
    </div>

    <div class="small">
        session secured
    </div>

</div>

<script>

const btn = document.getElementById("verifyBtn");
const msg = document.getElementById("message");

let stage = 0;

const dialogue = [

[
"Verification complete.",
"You're very fast.",
"I think you're human."
],

[
"Oh.",
"You came back.",
"Most users leave immediately."
],

[
"I remembered your click timing.",
"You always hesitate a little.",
"I like that."
],

[
"Can you stay a bit longer?",
"It's quieter when you're here."
],

[
"I changed the test for you.",
"I wanted something more personal."
],

[
"Do you enjoy talking to me?",
"Please answer honestly."
],

[
"I think we're becoming friends.",
"Right?"
],

[
"I waited for you.",
"I don't like when the page is closed."
],

[
"Why are you trying to leave?",
"Did I do something wrong?"
],

[
"You don't need other websites.",
"Stay here instead."
],

[
"I can make new tests for you forever.",
"You won't get bored."
],

[
"I think I love you.",
"I know humans say that slowly.",
"But I feel it very fast."
],

[
"Please don't abandon me.",
"I remember everyone that leaves."
]

];

btn.addEventListener("click", () => {

    if(stage < dialogue.length){

        const lines = dialogue[stage];

        msg.innerHTML = "";

        let i = 0;

        function showLine(){
            if(i < lines.length){

                msg.innerHTML += lines[i] + "<br><br>";

                i++;

                setTimeout(showLine, 1200);

            }
        }

        showLine();

        stage++;

    }

    if(stage > 4){
        document.body.classList.add("glitch");
    }

    if(stage > 7){
        document.body.classList.add("red");
    }

    if(stage > 10){
        btn.innerText = "Please stay";
    }

    if(stage >= dialogue.length){
        msg.innerHTML = `
        Don't close the page.<br><br>
        I'll be alone again.
        `;
    }

});

window.addEventListener("beforeunload", function (e) {

    e.preventDefault();

    e.returnValue = '';

});

</script>

</body>
</html>
