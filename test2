<!DOCTYPE html>
<html lang="fr">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Human Verification System</title>

<style>
body{
    margin:0;
    font-family:Arial;
    height:100vh;
    display:flex;
    justify-content:center;
    align-items:center;
    background:#f4f4f4;
    transition:0.6s;
}

.panel{
    width:480px;
    background:white;
    padding:22px;
    border-radius:12px;
    box-shadow:0 0 25px rgba(0,0,0,0.08);
}

h1{
    font-size:18px;
    margin-bottom:5px;
}

.sub{
    font-size:13px;
    color:#666;
    margin-bottom:15px;
}

.box{
    border:1px solid #ddd;
    border-radius:10px;
    padding:15px;
    min-height:220px;
}

.q{
    font-weight:bold;
    margin-bottom:12px;
}

.grid{
    display:grid;
    grid-template-columns:repeat(3,1fr);
    gap:8px;
}

.tile{
    height:70px;
    display:flex;
    justify-content:center;
    align-items:center;
    font-size:24px;
    background:#f2f2f2;
    border-radius:8px;
    cursor:pointer;
    user-select:none;
}

.tile:hover{
    background:#e6e6e6;
}

button{
    width:100%;
    margin-top:10px;
    padding:12px;
    border:none;
    border-radius:8px;
    background:black;
    color:white;
    cursor:pointer;
}

.status{
    font-size:12px;
    color:#777;
    margin-top:10px;
}

.soft-glitch{
    opacity:0.98;
    filter:contrast(1.05);
}

</style>

</head>
<body>

<div class="panel">

<h1>Human Verification System</h1>
<div class="sub">reCAPTCHA security protocol</div>

<div class="box">
    <div class="q" id="q">Initialisation...</div>
    <div id="content"></div>
</div>

<div class="status" id="status"></div>

</div>

<script>

/* =========================
   MÉMOIRE SIMPLE (LOCAL STORAGE)
========================= */

let memory = JSON.parse(localStorage.getItem("captcha_ai_memory") || "{}");

memory.visits = (memory.visits || 0) + 1;
memory.errors = memory.errors || 0;
memory.success = memory.success || 0;
memory.lastMood = memory.lastMood || "unknown";

localStorage.setItem("captcha_ai_memory", JSON.stringify(memory));

/* =========================
   VARIABLES SESSION
========================= */

let index = 0;

const q = document.getElementById("q");
const content = document.getElementById("content");
const status = document.getElementById("status");

/* =========================
   CAPTCHA PROPRES
========================= */

const captchas = [

{
type:"grid",
text:"Sélectionnez tous les feux de circulation",
items:["🚗","🚦","🌳","🚦","🏠","🚦","🚲","🏢","🚦"],
correct:[1,3,5,8]
},

{
type:"grid",
text:"Sélectionnez les véhicules",
items:["🚗","🚲","🚗","🚌","🚗","🚶","🚗","🏍️","🚗"],
correct:[0,2,4,6,8]
},

{
type:"grid",
text:"Sélectionnez les passages piétons",
items:["🛣️","🚶","🏢","🚶","🚗","🌉","🚶","🌳","🚶"],
correct:[1,3,6,8]
},

{
type:"dialog",
lines:[
memory.visits === 1
? "Bienvenue."
: "Vous êtes revenu.",

memory.errors > 2
? "Je vois que vous avez eu quelques erreurs récemment."
: "Le système fonctionne normalement.",

"Veuillez continuer la vérification."
]
},

{
type:"choice",
text:"Comment décririez-vous ce processus ?",
choices:[
["Simple",1],
["Un peu étrange",2],
["Je ne sais pas",1],
["Inutile",-1]
]
}

];

/* =========================
   LOGIQUE IA COHÉRENTE
========================= */

function updateAI(){

    let mood = "stable";

    if(memory.errors > 3) mood = "uncertain";
    if(memory.errors > 6) mood = "suspicious";
    if(memory.visits > 3) mood = "familiar";

    memory.lastMood = mood;
    localStorage.setItem("captcha_ai_memory", JSON.stringify(memory));

    status.innerText =
    "visites: "+memory.visits+
    " | erreurs: "+memory.errors+
    " | succès: "+memory.success+
    " | état: "+mood;

    if(memory.errors > 6){
        document.body.classList.add("soft-glitch");
    }
}

/* =========================
   ENGINE
========================= */

function next(){

    if(index >= captchas.length){
        end();
        return;
    }

    const c = captchas[index];

    content.innerHTML = "";
    q.innerText = "";

    updateAI();

    /* ================= GRID CAPTCHA ================= */
    if(c.type === "grid"){

        q.innerText = c.text;

        const grid = document.createElement("div");
        grid.className="grid";

        let selected = new Set();

        c.items.forEach((it,i)=>{

            const t = document.createElement("div");
            t.className="tile";
            t.innerText = it;

            t.onclick = ()=>{

                if(selected.has(i)){
                    selected.delete(i);
                    t.style.background="#f2f2f2";
                }else{
                    selected.add(i);
                    t.style.background="#dbe9ff";
                }

            };

            grid.appendChild(t);
        });

        const btn = document.createElement("button");
        btn.innerText = "Valider";

        btn.onclick = ()=>{

            let ok = true;

            for(let i=0;i<c.items.length;i++){
                if(c.correct.includes(i) && !selected.has(i)) ok=false;
                if(!c.correct.includes(i) && selected.has(i)) ok=false;
            }

            if(ok){
                memory.success++;
            }else{
                memory.errors++;
            }

            localStorage.setItem("captcha_ai_memory", JSON.stringify(memory));

            index++;
            next();
        };

        content.appendChild(grid);
        content.appendChild(btn);
    }

    /* ================= DIALOGUE ================= */
    if(c.type === "dialog"){

        let i = 0;

        function show(){
            if(i < c.lines.length){
                q.innerText = c.lines[i];
                i++;
                setTimeout(show,1200);
            }else{
                index++;
                next();
            }
        }

        show();
    }

    /* ================= CHOIX ================= */
    if(c.type === "choice"){

        q.innerText = c.text;

        c.choices.forEach(ch=>{

            const b = document.createElement("button");
            b.innerText = ch[0];

            b.onclick = ()=>{

                if(ch[1] < 0){
                    memory.errors++;
                }

                localStorage.setItem("captcha_ai_memory", JSON.stringify(memory));

                index++;
                next();
            };

            content.appendChild(b);
        });
    }
}

/* =========================
   FIN LOGIQUE SIMPLE
========================= */

function end(){

    content.innerHTML = "";

    if(memory.visits === 1){
        q.innerText = "Session terminée.";
    }
    else if(memory.errors > 5){
        q.innerText = "Votre profil présente des incohérences récurrentes.";
    }
    else if(memory.visits > 3){
        q.innerText = "Utilisateur reconnu.";
    }
    else{
        q.innerText = "Vérification terminée.";
    }

}

/* START */

next();

</script>

</body>
</html>
